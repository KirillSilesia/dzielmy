# Skopiuj do pliku .env i ustaw własne wartości. Pliku .env NIE commitujemy.
POSTGRES_USER=dzielmy
POSTGRES_PASSWORD=zmien-mnie
POSTGRES_DB=dzielmy
JWT_SECRET=zmien-mnie-na-dlugi-losowy-ciag
# :80 = lokalnie po HTTP; na serwerze: nazwa domeny (wtedy Caddy włącza HTTPS)
SITE_ADDRESS=:80
# e-mail do certyfikatów HTTPS (używany tylko na serwerze)
ACME_EMAIL=dev@localhost.localdomain
